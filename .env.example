# Server-side Google Maps Platform (Distance Matrix, Places, Geocoding)
# Restrict by IP in Google Cloud Console — never expose in the browser.
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here

# Browser-side Maps JavaScript API + Directions (Flutter web embedded map)
# Restrict by HTTP referrer in Google Cloud Console.
GOOGLE_MAPS_JS_API_KEY=your_google_maps_js_api_key_here

# Walking route destination for the embedded map (optional override)
DISNEYLAND_DESTINATION=1313 S Harbor Blvd, Anaheim, CA 92802

# Backend CORS (comma-separated origins for production)
CORS_ORIGINS=*

# Flutter web API base URL (pass via --dart-define=API_BASE_URL=...)
API_BASE_URL=http://localhost:8000
